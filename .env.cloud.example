# ==========================================
# 共通設定 (Common)
# ==========================================
APP_ENV=production

# ==========================================
# 前端設定 (Frontend)
# (Vite 會自動讀取 VITE_ 開頭的變數)
# ==========================================
VITE_API_BASE_URL=https://cypherhub-234430776857.asia-east1.run.app
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# ==========================================
# 後端設定 (Backend)
# ==========================================
FLASK_DEBUG=0
CORS_ORIGINS=https://your-frontend-domain.com
ADMIN_ALLOWLIST=

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# 綠界金流 (ECPay) - 正式環境
# ==========================================
ECPAY_STAGE=False
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# 需替換為後端正式接收 Webhook 的網址
ECPAY_RETURN_URL=https://cypherhub-234430776857.asia-east1.run.app/api/v1/webhooks/ecpay
ECPAY_ORDER_RESULT_URL=https://your-frontend-domain.com/orders/success

# ==========================================
# 第三方服務 (選填)
# ==========================================
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=CypherHub <onboarding@resend.dev>
