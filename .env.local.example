# ==========================================
# 共通設定 (Common)
# ==========================================
APP_ENV=development

# ==========================================
# 前端設定 (Frontend)
# (Vite 會自動讀取 VITE_ 開頭的變數)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# ==========================================
# 後端設定 (Backend)
# ==========================================
FLASK_DEBUG=1
CORS_ORIGINS=http://localhost:5173
ADMIN_ALLOWLIST=

# Supabase (Docker 內後端連線用)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# 綠界金流 (ECPay) - 測試環境預設值
# ==========================================
ECPAY_STAGE=True
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbCWpE5vM
ECPAY_HASH_IV=v77hoKGq4kWxNNuX
# 需替換為 ngrok 等對外公開網址以接收 Webhook
ECPAY_RETURN_URL=https://your-domain.com/api/v1/payments/ecpay/webhook
ECPAY_ORDER_RESULT_URL=http://localhost:5173/orders/success

# ==========================================
# 第三方服務 (選填)
# ==========================================
